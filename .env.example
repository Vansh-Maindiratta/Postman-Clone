# API Lab environment variables
# Copy this file to .env at the repository root for local development.
# No secrets belong here — VITE_ variables are baked into the browser bundle.

# --- Backend (read by server/ through npm run dev / npm start) ---

# Port for the CORS proxy (defaults to 3001). Render assigns this at runtime.
PORT=3001

# Browser origin allowed to call /proxy (local Vite dev server by default).
# In production set this to the deployed Vercel frontend URL.
# Backend only.
CLIENT_URL=http://localhost:5173

# --- Frontend (build time; Vite exposes VITE_ vars to the browser code) ---

# Base URL of the proxy backend used by the production build.
# Leave unset locally: the Vite dev server forwards /proxy to localhost:3001.
# In production set it to the Render backend URL, e.g. https://api-lab.onrender.com
# Frontend only.
VITE_API_URL=http://localhost:3001
