# API Lab frontend environment variables (Vite).
# Copy this file to frontend/.env for local development.
# VITE_ variables are PUBLIC: they are baked into the browser bundle.
# Never put secrets here.

# Base URL of the deployed backend (Render), no trailing slash.
# Leave UNSET locally: the Vite dev server forwards /proxy to the local
# backend (http://localhost:3001) automatically, so no configuration is needed.
# In production set it to the Render backend URL, e.g.
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
