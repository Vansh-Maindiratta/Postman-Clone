# API Lab backend (CORS proxy) environment variables.
# Copy this file to backend/.env for local development.
# On Render you set these in the dashboard instead — no .env file is needed.
# No secrets belong here.

# Port the proxy listens on (defaults to 3001).
# Render assigns PORT at runtime; do not set it on Render.
PORT=3001

# Browser origin(s) allowed to call the proxy (CORS). Comma-separated for more
# than one. Local default below; in production set it to the deployed Vercel
# frontend URL, e.g. CLIENT_URL=https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173
